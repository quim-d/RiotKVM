# Maintainer: RiotKVM <noreply@users.noreply.github.com>
_owner=quim-d   # usuario u organización de GitHub del repo
# Compila desde la fuente de la release de GitHub. Antes de usarlo: ajusta _owner (usuario/organización del repo) y
# ejecuta `updpkgsums` para rellenar el sha256 del tarball (o usa `makepkg -g >> PKGBUILD`).
pkgname=riotkvm
conflicts=('quim-dkvm')
replaces=('quim-dkvm')
provides=('quim-dkvm')
pkgver=0.2.0   # súbelo a la primera release con los crates riotkvm-* (las anteriores se llaman dkvm-*)
pkgrel=1
pkgdesc='RiotKVM: KVM de bolsillo (CLI riotkvm y GUI riotkvm-gui) para el dongle ESP32-S3'
arch=('x86_64' 'aarch64')
url="https://github.com/${_owner}/RiotKVM"
license=('custom')   # sin LICENSE definida todavía: cambia por la elegida
depends=('dbus' 'libxkbcommon' 'wayland' 'libx11' 'libglvnd' 'vulkan-icd-loader' 'bluez' 'gcc-libs')
optdepends=('v4l-utils: diagnóstico de capturadoras UVC'
            'bluez-utils: bluetoothctl para emparejar/depurar BLE')
makedepends=('cargo' 'pkgconf' 'nasm' 'cmake' 'gcc' 'clang')
source=("$pkgname-$pkgver.tar.gz::https://github.com/${_owner}/RiotKVM/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # `updpkgsums` lo sustituye

prepare() {
  cd "$srcdir/RiotKVM-$pkgver/client"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/RiotKVM-$pkgver/client"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen -p riotkvm-cli -p riotkvm-gui
  mkdir -p target/completions
  target/release/riotkvm completion bash > target/completions/riotkvm.bash
  target/release/riotkvm completion zsh > target/completions/_riotkvm
  target/release/riotkvm completion fish > target/completions/riotkvm.fish
}

check() {
  cd "$srcdir/RiotKVM-$pkgver/client"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --frozen -p riotkvm-core -p riotkvm-cli
}

package() {
  cd "$srcdir/RiotKVM-$pkgver"
  install -Dm755 client/target/release/riotkvm     "$pkgdir/usr/bin/riotkvm"
  install -Dm755 client/target/release/riotkvm-gui "$pkgdir/usr/bin/riotkvm-gui"
  install -Dm644 client/target/completions/riotkvm.bash "$pkgdir/usr/share/bash-completion/completions/riotkvm"
  install -Dm644 client/target/completions/_riotkvm     "$pkgdir/usr/share/zsh/site-functions/_riotkvm"
  install -Dm644 client/target/completions/riotkvm.fish "$pkgdir/usr/share/fish/vendor_completions.d/riotkvm.fish"
  install -Dm644 packaging/linux/riotkvm-gui.desktop "$pkgdir/usr/share/applications/riotkvm-gui.desktop"
  install -Dm644 client/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  [ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || true
}
